{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "desktop-windows",
      "displayName": "Windows x64 (MSVC)",
      "binaryDir": "${sourceDir}/out/build/desktop-windows",
      "generator": "Ninja Multi-Config",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "VCPKG_MANIFEST_MODE": "ON"
      }
    },
    {
      "name": "emscripten-wasm-base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
    },
    {
      "name": "emscripten-wasm-debug",
      "displayName": "Emscripten (WebAssembly) — Debug",
      "inherits": "emscripten-wasm-base",
      "binaryDir": "${sourceDir}/out/build/emscripten-wasm-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "emscripten-wasm-release",
      "displayName": "Emscripten (WebAssembly) — Release",
      "inherits": "emscripten-wasm-base",
      "binaryDir": "${sourceDir}/out/build/emscripten-wasm-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Windows-Debug",
      "configurePreset": "desktop-windows",
      "configuration": "Debug"
    },
    {
      "name": "Windows-Release",
      "configurePreset": "desktop-windows",
      "configuration": "Release"
    },
    {
      "name": "WebAssembly-Debug",
      "configurePreset": "emscripten-wasm-debug"
    },
    {
      "name": "WebAssembly-Release",
      "configurePreset": "emscripten-wasm-release"
    }
  ]
}